# --- Database ---
# Any SQLAlchemy URL works. Default assumes the docker-compose Postgres below.
DATABASE_URL=postgresql+psycopg2://verdant:verdant@localhost:5432/verdant

# --- Webhook signature ---
# HMAC-SHA256 secret used to verify the X-Signature header on incoming webhooks.
WEBHOOK_SECRET=verdant-demo-secret-2026

# --- Auth ---
# Secret used to sign agent session JWTs. Change this in production.
JWT_SECRET=change-me-in-production
# Seed agent credentials (created on first startup if the agent does not exist).
SEED_AGENT_USERNAME=agent
SEED_AGENT_PASSWORD=verdant123

# --- LLM (Groq) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Brand this deployment serves (forward-looking for multi-brand).
DEFAULT_BRAND_ID=verdant-co
